NODE_ENV=development
PORT=3001

# Postgres — must match the credentials in docker-compose.yml
DATABASE_URL="postgresql://crove:crove_secret@localhost:5432/crove_db"

# Redis
REDIS_URL="redis://localhost:6379"

# Better Auth — signs and verifies session tokens
# Must be at least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-this-to-a-long-random-secret-min-32-chars"

# CORS — the frontend origin allowed to make requests
CORS_ORIGIN="http://localhost:3000"

# Logging
LOG_LEVEL=info

# Payment provider (add when integrating Paystack)
# PAYSTACK_SECRET_KEY=""
