NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────
# Must match credentials in docker-compose.yml
DATABASE_URL="postgresql://crove:crove_secret@localhost:5432/crove_db"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Signs and verifies session tokens — must be at least 32 characters
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-this-to-a-long-random-secret-min-32-chars"

# ── URLs ──────────────────────────────────────────────────────────────────────
# Public URL of this API server (Better Auth uses it for OAuth callbacks + email links)
APP_URL="http://localhost:3001"

# Public URL of the frontend app (used in payment redirect links and email CTAs)
FRONTEND_URL="http://localhost:3000"

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Leave blank to disable Google sign-in entirely.
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add authorised redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payment ───────────────────────────────────────────────────────────────────
# Active provider: "paystack" | "bachs"
ACTIVE_PAYMENT_PROVIDER=paystack

# Paystack — https://dashboard.paystack.com/#/settings/developers
# Use the test secret key for development, live key for production
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bachs
BACHS_TEST_KEY=
BACHS_LIVE_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
# Active provider: "resend" | "sendbyte"
ACTIVE_EMAIL_PROVIDER=resend

# Address all platform emails are sent from (must be a verified domain)
EMAIL_FROM_ADDRESS="noreply@crove.app"

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendByte
SENDBYTE_API_KEY=
